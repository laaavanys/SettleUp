NODE_ENV=production
PORT=4000
# DB_PATH is optional — defaults to backend/data/app.db. Only set this if
# you've attached a persistent disk/volume, otherwise data is lost on redeploy.
# DB_PATH=/var/data/app.db
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key-here
# Get a free API key at https://resend.com — without it, invite/notification
# emails are silently skipped (logged as a warning) instead of failing.
RESEND_API_KEY=your-resend-api-key-here
# Must be onboarding@resend.dev unless you've verified your own domain on Resend.
EMAIL_FROM=SettleUp <onboarding@resend.dev>
# Public URL of the deployed frontend — used to build links inside emails.
APP_URL=http://localhost:5173
