NODE_ENV=production
PORT=4000
# DB_PATH is optional — defaults to backend/data/app.db. Only set this if
# you've attached a persistent disk/volume, otherwise data is lost on redeploy.
# DB_PATH=/var/data/app.db
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key-here
# Free Gmail SMTP — no card, no third-party signup. Turn on 2-Step
# Verification on your Google Account, then generate an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (NOT
# your normal Gmail password). Without these, invite/notification emails
# are silently skipped (logged as a warning) instead of failing.
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=SettleUp <your-gmail-address@gmail.com>
# Public URL of the deployed frontend — used to build links inside emails.
APP_URL=http://localhost:5173
